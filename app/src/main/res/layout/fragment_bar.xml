<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BarFragment">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/bar"
        android:layout_gravity="center|bottom"
        android:contentDescription="bar for buttons"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingBottom="32dp">
        <ImageButton
            android:id="@+id/plan_btn"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/AppTheme.RoundedCornerMaterialButton"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/plans_unact"
            android:contentDescription="Plan" />
        <ImageButton
            android:id="@+id/smth_btn"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            style="@style/AppTheme.RoundedCornerMaterialButton"
            android:padding="12dp"
            android:scaleType="centerInside"
            />
        <ImageButton
            android:id="@+id/setting_btn"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/AppTheme.RoundedCornerMaterialButton"

            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/setting_unact"
            android:contentDescription="Settings" />
    </LinearLayout>
</FrameLayout>